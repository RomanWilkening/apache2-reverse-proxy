# DynDNS Konfiguration (Custom-only)

# Eine einzige Update-URL mit Platzhaltern {DOMAIN}, {PASSWORT}, {IPV4}, {IPV6}
# Hinweis: Die URL DARF Kommata enthalten.
# Beispiel:
# CUSTOM_URL=https://dyn.example.com/update?d={DOMAIN},ip4={IPV4},ip6={IPV6},pw={PASSWORT}

# Kommagetrennte Liste der zu aktualisierenden Domains
# Hinweis: Werte mit Leerzeichen können optional in Anführungszeichen stehen.
# Beispiel:
# CUSTOM_DOMAINS="app.example.com, www.example.com, api.example.com"

# Passwort (wird in {PASSWORT} eingesetzt)
# Beispiel:
# CUSTOM_PASSWORT=mein-super-passwort

# Optional: HTTP-Methode (GET|POST), Standard GET
# CUSTOM_METHOD=GET

# --- Optional ---
# DISABLE_IPV4/DISABLE_IPV6: auf "true" setzen, um die jeweilige IP-Version
# NICHT zu ermitteln und NICHT zu übertragen. Standard (unverändert/false):
# die jeweilige IP-Version wird ermittelt und übertragen.
# DISABLE_IPV6=true
# DISABLE_IPV4=true

# --- IPv6 Hinweis ---
# Damit IPv6-Ermittlung im Container funktioniert, muss IPv6 im Docker-Netzwerk
# aktiviert sein. Siehe docker-compose.yml (enable_ipv6: true) und README.md
# für die Konfiguration des Docker-Daemons.
# Alternativ: docker-compose.host-network.yml nutzen (einfachste Variante).

# Timeout in Sekunden für HTTP-Anfragen (IP-Ermittlung und Updates)
# CURL_TIMEOUT=10

# Cron-Zeitplan (Standard: */5 * * * *)
# DYNDNS_CRON=*/5 * * * *

# --- MQTT / Home Assistant Integration (optional) ---
# IP-Adresse oder Hostname des MQTT-Brokers
# MQTT_HOST=192.168.1.100

# Port des MQTT-Brokers (Standard: 1883)
# MQTT_PORT=1883

# Benutzername für den MQTT-Broker (optional)
# MQTT_USER=mqtt_user

# Passwort für den MQTT-Broker (optional)
# MQTT_PASSWORD=mqtt_passwort

# MQTT Topic-Präfix (Standard: dyndns)
# MQTT_TOPIC_PREFIX=dyndns
